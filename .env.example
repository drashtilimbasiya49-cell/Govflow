# GovFlow AI — Environment Configuration
# Copy this file to .env for local Supabase and external notification provider setup.

# Supabase PostgreSQL & Auth Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-placeholder

# WhatsApp Business Platform API Adapter (Optional)
VITE_WHATSAPP_API_TOKEN=your-whatsapp-token-placeholder
VITE_WHATSAPP_PHONE_ID=your-whatsapp-phone-id-placeholder

# SMS Gateway Adapter (Optional)
VITE_SMS_GATEWAY_API_KEY=your-sms-api-key-placeholder
